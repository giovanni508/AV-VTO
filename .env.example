# =============================================================================
# AV-VTO — Template variabili d'ambiente
# Copia questo file in `.env.local` e riempi i valori. NON committare i segreti.
# =============================================================================

# --- Supabase (valori PUBBLICI, lato client) --------------------------------
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Supabase (SEGRETO, solo lato server: bypassa la RLS) -------------------
# Usata da webhook Stripe / server actions che scrivono crediti e generations.
# NON esporla MAI al client (niente prefisso NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Replicate (SEGRETO, solo lato server) ----------------------------------
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your-replicate-api-token
