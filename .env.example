# =============================================================================
# AV-VTO — Template variabili d'ambiente
# Copia questo file in `.env.local` e riempi i valori. NON committare i segreti.
# =============================================================================

# --- Supabase (valori PUBBLICI, lato client) --------------------------------
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Supabase (SEGRETO, solo lato server: bypassa la RLS) -------------------
# Usata da webhook Stripe / server actions che scrivono crediti e generations.
# NON esporla MAI al client (niente prefisso NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Replicate (SEGRETO, solo lato server) ----------------------------------
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your-replicate-api-token

# Modelli Replicate (opzionali). Formato "owner/nome" oppure "owner/nome:hash".
# Default: Nano Banana 2 (Google Gemini Image) per entrambe le modalità.
# Alternative: google/nano-banana, cuuupid/idm-vton (solo try-on).
# REPLICATE_MODEL=google/nano-banana-2
# REPLICATE_PRODUCT_MODEL=google/nano-banana-2
# REPLICATE_MODEL_GEN=google/nano-banana-2
# REPLICATE_ENHANCE_MODEL=philz1337x/clarity-upscaler

# --- Video (Seedance 2.0) ---------------------------------------------------
# Generazione video (animazione immagini). Default: bytedance/seedance-2.0.
# Per dimezzare i costi: bytedance/seedance-2.0-mini.
# Risoluzione: 480p | 720p | 1080p | 4k (default 720p).
# NB: la generazione video può durare 1–3 min: richiede function fino a 300s
# (Vercel Pro). Su Hobby (max 60s) usare clip brevi o fare l'upgrade.
# REPLICATE_VIDEO_MODEL=bytedance/seedance-2.0
# REPLICATE_VIDEO_RESOLUTION=720p
